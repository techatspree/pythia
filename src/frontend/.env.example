# 'dev' | 'entra' | 'keycloak' — picks the auth module
VITE_AUTH_PROVIDER=dev

# --- Entra ID module (only when VITE_AUTH_PROVIDER=entra) ---
# Microsoft Entra (Azure AD) tenant id (GUID).
VITE_ENTRA_TENANT_ID=
# SPA app registration's client id (used by MSAL on the browser).
VITE_ENTRA_SPA_CLIENT_ID=
# API app registration's client id (used to derive the access scope
# `api://<api-client-id>/access`).
VITE_ENTRA_API_CLIENT_ID=
# Redirect URI registered on the SPA app. Local dev typically uses
# http://localhost:5173; production uses the public host.
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

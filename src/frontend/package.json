{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen:api": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
		"gen:icons": "node scripts/generate-icons.mjs",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"lint:report": "node -e \"require('fs').mkdirSync('reports',{recursive:true})\" && (eslint . -f json -o reports/eslint.json || true) && (eslint . -f html -o reports/eslint.html || true)"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@html-eslint/eslint-plugin": "^0.62.0",
		"@html-eslint/parser": "^0.62.0",
		"@originjs/vite-plugin-commonjs": "^1.0.3",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.4",
		"eslint": "^9.39.4",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"svelte-eslint-parser": "^1.8.0",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@azure/msal-browser": "^5.13.0",
		"loglevel": "^1.9.2",
		"svelte-dnd-action": "^0.9.69",
		"svelte-i18n": "^4.0.1"
	}
}

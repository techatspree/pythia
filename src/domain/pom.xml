<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.theestimator</groupId>
    <artifactId>domain</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>The Estimator Domain Model</name>

    <build>
        <!-- Point Maven's outputDirectory at Gradle's JVM output so reactor-workspace resolution works -->
        <outputDirectory>${project.basedir}/build/classes/kotlin/jvm/main</outputDirectory>
        <plugins>
            <!-- Delegate clean to Gradle so build/ is removed -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.basedir}/build</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>

            <!-- Step 1: Compile JVM classes via Gradle KMP (handles @JsExport / @OptionalExpectation) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>gradle-compile-jvm</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/gradlew</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>compileKotlinJvm</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Step 1b: Run JVM tests via Gradle -->
                    <execution>
                        <id>gradle-test-jvm</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/gradlew</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>jvmTest</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Step 2: Build TypeScript zip via Gradle KMP in package phase -->
                    <execution>
                        <id>gradle-package-typescript</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/gradlew</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>packageTypescript</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Step 3: Package Gradle-compiled JVM classes into the JAR Maven expects -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <classesDirectory>${project.basedir}/build/classes/kotlin/jvm/main</classesDirectory>
                </configuration>
            </plugin>

            <!-- Step 4: Attach the TypeScript zip as a classifier artifact for the frontend -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>attach-typescript-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.basedir}/build/typescript/domain-${project.version}-typescript.zip</file>
                                    <type>zip</type>
                                    <classifier>typescript</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
